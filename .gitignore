# Production secrets / configs — never commit the live config.
server/config.php
# Local working copies (but DO commit the *.example.php templates).
*.local.php
!*.local.example.php

# Test environment
tests/.env
tests/.venv/
tests/.pytest_cache/
tests/__pycache__/

# OS / editor noise
.DS_Store
Thumbs.db
*~
~$*
.~lock.*
.idea/
.vscode/
*.swp
*.swo

# Node / build artefacts (in case we add a build step later)
node_modules/
.npm/

# Local-stack volumes
.docker/
.data/

# Generated outputs we don't commit (regenerated from sources)
# (We DO commit the user guides + architecture / data model docs;
#  they're source of truth deliverables.)

# Logs
*.log
storage/

# Personal / per-machine CA bundles dropped into the local PHP container
# (e.g. corporate Zscaler root from `security find-certificate`). Never
# commit — these are device-specific and may contain corporate secrets.
docker/zscaler.crt
docker/all-roots.crt
