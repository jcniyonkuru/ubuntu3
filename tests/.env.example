# Copy to .env and fill in. The .env file is gitignored.

# The base URL of the Ubuntu 3.0 deployment to test against.
TEST_BASE_URL=https://ubuntu3.academyubuntu.com

# A dedicated admin account used by the suite. Create one in the admin
# console — DON'T reuse your own; these tests will write data.
TEST_ADMIN_EMAIL=regression-bot@ubuntu3.local
TEST_ADMIN_PASSWORD=change-me
